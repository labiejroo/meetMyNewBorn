# Origin strony rodzinnej, w której apka jest osadzona w iframe.
# Tylko tam wysyłamy postMessage i tylko stamtąd przyjmujemy wiadomości.
# Ta sama wartość ląduje w nagłówku CSP frame-ancestors (next.config.mjs).
# Lokalnie parent-app (Vite) stoi na 5173.
#
# BEZ koncowego ukosnika. Przegladarka w event.origin nigdy go nie podaje,
# wiec adres z ukosnikiem nie dopasuje sie do zadnej wiadomosci od rodzica.
# Kod normalizuje te wartosc, ale nie polegaj na tym przy konfiguracji.
NEXT_PUBLIC_PARENT_ORIGIN=http://localhost:5173

# Adres backendu.
#
# PRODUKCJA: zostaw PUSTE. Apka i /api stoją za tym samym CloudFrontem, więc
# requesty idą pod adres relatywny — domena nie jest wpisana w kodzie.
#
# LOKALNIE (next dev): puste = gościnny przepływ działa na mockach.
# Żeby pracować przeciwko prawdziwemu API, wskaż tu CloudFront:
#   NEXT_PUBLIC_API_BASE_URL=https://d3idn259a1zzt7.cloudfront.net
#
# Panel gospodarzy (?zoja), feedback i linki decyzyjne zostają na mockach
# niezależnie od tej zmiennej — nie mają jeszcze endpointów.
NEXT_PUBLIC_API_BASE_URL=

# Cloudflare Turnstile — klucz PUBLICZNY widgetu.
#
# Nie jest sekretem: trafia do bundla JS i widzi go każdy gość. Sekret
# (secret key) mieszka wyłącznie w AWS Secrets Manager pod zoja/turnstile
# i nie ma prawa pojawić się w tym repozytorium.
#
# PUSTE = widget się nie renderuje, a formularz działa jak dotąd. Tak ma być
# lokalnie i w buildach sprzed etapu TURNSTILE B.
#
# Wartość produkcyjną tworzy się ręcznie w panelu Cloudflare:
#   Turnstile -> Add widget, hostname d3idn259a1zzt7.cloudfront.net, tryb Managed.
# Hostname to domena CloudFrontu, NIE strona rodzinna na Netlify — dokument
# w iframe pochodzi z CloudFrontu i to jego widzi Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
